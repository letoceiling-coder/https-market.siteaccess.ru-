[Unit]
Description=HELP HOMES (market.siteaccess.ru) Next.js production
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=market
Group=market
WorkingDirectory=/var/www/market.siteaccess.ru/current
EnvironmentFile=/var/www/market.siteaccess.ru/shared/.env
ExecStart=/usr/bin/node server.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=mixed
Nice=5
MemoryMax=768M
MemoryHigh=640M
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/market.siteaccess.ru
StandardOutput=journal
StandardError=journal
SyslogIdentifier=market-siteaccess

[Install]
WantedBy=multi-user.target
