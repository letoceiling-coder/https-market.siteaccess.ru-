[Unit]
Description=HELP HOMES API queue worker
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=helphomes-api
Group=helphomes-api
WorkingDirectory=/var/www/helphomes-api
ExecStart=/usr/bin/php /var/www/helphomes-api/artisan queue:work redis --sleep=1 --tries=3 --max-time=3600
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
Nice=10
MemoryMax=192M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/helphomes-api/storage /var/www/helphomes-api/bootstrap/cache
SyslogIdentifier=helphomes-api-queue

[Install]
WantedBy=multi-user.target
